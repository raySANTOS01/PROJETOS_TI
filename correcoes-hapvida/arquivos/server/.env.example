# Conexão com o banco MySQL. Formato: mysql://USUARIO:SENHA@HOST:3306/NOME_DO_BANCO
# Na VPS o banco roda na mesma máquina do backend, então o HOST é "localhost".
DATABASE_URL="mysql://hapvida_app:senha_super_forte@localhost:3306/hapvida_ranking"

# Porta do servidor Express + Socket.io
PORT=3333
# Interface de rede. Na VPS use 127.0.0.1 (so o Nginx, na mesma maquina,
# acessa o Node). Em desenvolvimento, pode omitir (escuta em todas).
HOST=127.0.0.1

# Origem permitida no CORS (URL do frontend). Aceita várias, separadas por vírgula.
# Desenvolvimento: "http://localhost:5173"   |   VPS (pela VPN): "http://10.10.0.1"
CLIENT_URL="http://localhost:5173"

# Segredo usado para assinar o token JWT do login dos corretores.
# Esse mesmo login (email + senha) agora e usado tanto no painel do
# corretor quanto para abrir o dashboard na TV - por isso a validade
# padrao e mais longa (a TV fica ligada 24/7 e nao pode ficar
# deslogando sozinha no meio da madrugada).
JWT_SECRET="troque-por-uma-chave-bem-grande-e-aleatoria"
JWT_EXPIRES_IN="30d"

# --- E-mail (opcional) ---
# Usado para avisar os administradores quando um corretor se cadastra
# (aguardando aprovacao) e para avisar o corretor quando o cadastro dele
# e aprovado/rejeitado. Se deixar em branco, as notificacoes so aparecem
# no console do servidor - util para testar localmente sem SMTP real.
# Exemplo com Gmail: crie uma "senha de app" em myaccount.google.com/apppasswords
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Ranking Hapvida <nao-responda@suacorretora.com.br>"

# Chave usada para criptografar CPF/CNPJ das adesoes (AES-256). Gere uma
# string aleatoria grande e nunca reaproveite - trocar depois de ja ter
# dados salvos torna o que ja foi criptografado ilegivel.
DADOS_SENSIVEIS_CHAVE="troque-por-uma-string-bem-grande-e-aleatoria"

# Admin inicial (usado só pelo "npm run seed"; apague estas linhas depois)
SEED_ADMIN_1_NOME="Seu Nome"
SEED_ADMIN_1_EMAIL="seu@email.com"
SEED_ADMIN_1_SENHA="troque-por-uma-senha-forte-com-10-ou-mais-caracteres"
