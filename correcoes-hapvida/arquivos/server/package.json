{
  "name": "hapvida-ranking-server",
  "version": "1.0.0",
  "description": "Backend do Ranking de Vendas ao Vivo - Hapvida",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "limpar-tudo": "node limpar-tudo.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:deploy": "prisma migrate deploy",
    "db:deploy": "prisma generate && prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "node seed.js",
    "backup": "node backup.js",
    "exportar-dados": "node exportar-dados.js",
    "limpar-vendas": "node limpar-vendas.js",
    "corrigir-fotos": "node corrigir-fotos-antigas.js",
    "postinstall": "prisma generate",
    "setup": "prisma generate && prisma migrate dev --name auto && node seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.19.1"
  }
}